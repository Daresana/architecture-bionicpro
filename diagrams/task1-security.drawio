    <diagram name="PKCE в учебном приложении" id="PKCE в учебном приложении">
        <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1740" pageHeight="1050" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="&lt;b&gt;Учебный контур — Authorization Code + PKCE&lt;/b&gt;" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1E2A44;fontSize=28;spacing=8;">
                    <mxGeometry x="40" y="25" width="1650" height="55" as="geometry" />
                </mxCell>
                <mxCell id="scope" value="Реализация в starter: React + keycloak-js и Keycloak. BFF выше — отдельное предложение целевой архитектуры." parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1E2A44;fontSize=20;spacing=8;">
                    <mxGeometry x="40" y="85" width="1650" height="65" as="geometry" />
                </mxCell>
                <object placeholders="1" c4Name="React" c4Type="Container" c4Technology="keycloak-js" c4Description="initOptions: pkceMethod = 'S256'" label="&lt;b&gt;React&lt;/b&gt;&lt;div&gt;[Container: keycloak-js]&lt;/div&gt;&lt;p&gt;initOptions: pkceMethod = &amp;#x27;S256&amp;#x27;&lt;/p&gt;" id="spa">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];;fontSize=17;fontColor=#FFFFFF;fillColor=#1B2B59;strokeColor=#1B2B59;spacing=12;" parent="1" vertex="1">
                        <mxGeometry x="80" y="220" width="360" height="180" as="geometry" />
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="Keycloak" c4Type="Container" c4Technology="reports-realm" c4Description="PKCE S256 обязателен; Implicit и password grant выключены; точный redirect URI" label="&lt;b&gt;Keycloak&lt;/b&gt;&lt;div&gt;[Container: reports-realm]&lt;/div&gt;&lt;p&gt;PKCE S256 обязателен; Implicit и password grant выключены; точный redirect URI&lt;/p&gt;" id="kc">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];;fontSize=17;fontColor=#FFFFFF;fillColor=#1B2B59;strokeColor=#1B2B59;spacing=12;" parent="1" vertex="1">
                        <mxGeometry x="690" y="220" width="390" height="180" as="geometry" />
                    </mxCell>
                </object>
                <object placeholders="1" c4Name="Reports API" c4Type="Container" c4Technology="C# / ASP.NET Core" c4Description="Проверяет JWT и запрашивает только строки sub" label="&lt;b&gt;Reports API&lt;/b&gt;&lt;div&gt;[Container: C# / ASP.NET Core]&lt;/div&gt;&lt;p&gt;Проверяет JWT и запрашивает только строки sub&lt;/p&gt;" id="api">
                    <mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];;fontSize=17;fontColor=#FFFFFF;fillColor=#1B2B59;strokeColor=#1B2B59;spacing=12;" parent="1" vertex="1">
                        <mxGeometry x="1280" y="220" width="360" height="180" as="geometry" />
                    </mxCell>
                </object>
                <mxCell id="edge-1" source="spa" target="kc" value="1. challenge + state + nonce" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="edge-2" source="kc" target="spa" value="2. Одноразовый code" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="880" y="470" />
                            <mxPoint x="260" y="470" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-3" source="spa" target="kc" value="3. code + verifier → локальный access token" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="260" y="560" />
                            <mxPoint x="880" y="560" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-4" source="spa" target="api" value="4. GET /reports; Bearer access token" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="260" y="650" />
                            <mxPoint x="1460" y="650" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="rule" value="Перехваченный code не обменивается без verifier. API отдельно проверяет право на отчёт: PKCE не заменяет авторизацию." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="80" y="780" width="1560" height="150" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>