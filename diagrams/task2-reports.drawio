    <diagram name="DAG и витрина" id="DAG и витрина">
        <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1180" math="0" shadow="0">
            <root>
                <mxCell id="0" />
                <mxCell id="1" parent="0" />
                <mxCell id="title" value="&lt;b&gt;ETL и публикация витрины&lt;/b&gt;" parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1E2A44;fontSize=28;spacing=8;">
                    <mxGeometry x="40" y="20" width="1800" height="60" as="geometry" />
                </mxCell>
                <mxCell id="extract" value="&lt;b&gt;extract&lt;/b&gt;&lt;br&gt;&lt;br&gt;Читает CRM и телеметрию за завершённый UTC-день. XCom передаёт только путь к файлу." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="60" y="170" width="520" height="190" as="geometry" />
                </mxCell>
                <mxCell id="transform" value="&lt;b&gt;transform&lt;/b&gt;&lt;br&gt;&lt;br&gt;Соединяет по prosthesis_id; проверяет владельца; считает движения и средние signal/battery." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="670" y="170" width="520" height="190" as="geometry" />
                </mxCell>
                <mxCell id="load" value="&lt;b&gt;load&lt;/b&gt;&lt;br&gt;&lt;br&gt;Пишет usage_reports с batch_id, затем report_periods. Повтор не удваивает готовый отчёт." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="1280" y="170" width="520" height="190" as="geometry" />
                </mxCell>
                <mxCell id="edge-1" source="extract" target="transform" value="source.json" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="edge-2" source="transform" target="load" value="report.json" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="usage" value="&lt;b&gt;usage_reports&lt;/b&gt;&lt;br&gt;&lt;br&gt;user_id · report_date · prosthesis_id&lt;br&gt;client_name · movement_count&lt;br&gt;average_signal · average_battery&lt;br&gt;batch_id · version&lt;br&gt;&lt;br&gt;ReplacingMergeTree(version)&lt;br&gt;PARTITION BY месяц&lt;br&gt;ORDER BY (user_id, report_date, prosthesis_id, batch_id)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="160" y="500" width="700" height="360" as="geometry" />
                </mxCell>
                <mxCell id="periods" value="&lt;b&gt;report_periods&lt;/b&gt;&lt;br&gt;&lt;br&gt;report_date · batch_id · version&lt;br&gt;&lt;br&gt;ReplacingMergeTree(version)&lt;br&gt;ORDER BY report_date&lt;br&gt;&lt;br&gt;Публикация последним действием DAG.&lt;br&gt;API сначала выбирает batch_id для дня." parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBDAF0;fontColor=#1E2A44;fontSize=17;spacing=10;">
                    <mxGeometry x="1040" y="500" width="700" height="360" as="geometry" />
                </mxCell>
                <mxCell id="edge-3" source="load" target="usage" value="1. Загрузка строк" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1540" y="420" />
                            <mxPoint x="510" y="420" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="edge-4" source="load" target="periods" value="2. Публикация дня" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#5D6C8C;strokeWidth=2;fontSize=15;fontColor=#1E2A44;labelBackgroundColor=#FFFFFF;">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="grain" value="Зерно строки: один пользователь, один протез, один UTC-день. batch_id — версия расчёта дня. FINAL устраняет повторы одного batch; новый batch публикуется отдельной записью после успешной загрузки." parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#1E2A44;fontSize=21;spacing=8;">
                    <mxGeometry x="100" y="950" width="1680" height="100" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
